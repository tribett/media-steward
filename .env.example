# Media Steward environment variables
# Copy this file to BOTH:
#   .env           (repo root — read by Prisma CLI and start.sh)
#   apps/web/.env  (read by the Next.js dashboard at runtime)
#
# After setting DATABASE_URL, initialise the DB once:
#   npx prisma db push --schema=packages/db/prisma/schema.prisma

# ── Database ─────────────────────────────────────────────────────────────────
# Use an absolute path so Prisma finds it regardless of working directory.
# Example (macOS/Linux):
DATABASE_URL=file:/home/youruser/media-steward/data/dev.db

# ── DNS upstream server ───────────────────────────────────────────────────────
# Default when unset: 8.8.8.8 (Google)
UPSTREAM_DNS=8.8.8.8
